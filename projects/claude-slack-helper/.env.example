# Which brain answers questions. claude-code = `claude -p` + MCP (default). api = Anthropic SDK.
BRAIN=claude-code
# Model for either backend. claude-sonnet-5-5 is roughly half the cost of the default.
HELPER_MODEL=claude-opus-5-5
# Only needed for BRAIN=api (and setting it switches the default brain to api).
# ANTHROPIC_API_KEY=sk-ant-...
# Slack: bot token (xoxb-) from OAuth & Permissions, app-level token (xapp-) with connections:write.
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
# Where thumbs up/down land. Default: ./feedback.jsonl
# FEEDBACK_PATH=/var/lib/orbit-helper/feedback.jsonl
